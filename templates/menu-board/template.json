{
  "id": "menu-board",
  "version": "1.5.1",
  "name": "Menu Board",
  "description": "A priced list in one or two columns with optional tags. For menus, service lists and price lists.",
  "fields": {
    "title": { "type": "text", "label": "Title", "default": "Menu", "maxLength": 32 },
    "subtitle": { "type": "text", "label": "Subtitle", "default": "", "maxLength": 60 },
    "items": {
      "type": "list",
      "label": "Items",
      "maxItems": 12,
      "item": {
        "name": { "type": "text", "label": "Name", "maxLength": 36 },
        "description": { "type": "text", "label": "Description", "default": "", "maxLength": 70 },
        "price": { "type": "text", "label": "Price", "maxLength": 10 },
        "tag": { "type": "select", "label": "Tag", "options": ["", "New", "Popular", "Vegan", "Spicy", "Limited"], "default": "" }
      }
    },
    "footnote": { "type": "text", "label": "Footnote", "default": "", "maxLength": 120 },
    "accent": { "type": "color", "label": "Accent colour", "default": "$brand.accent" },
    "theme": { "type": "select", "label": "Theme", "options": ["dark", "light"], "default": "dark" }
  },
  "duration": { "defaultMs": 12000, "minMs": 5000, "maxMs": 3600000 },
  "orientations": ["landscape", "portrait"],
  "uses": [],
  "background": "#14110f",
  "live": { "source": "table", "fields": { "items": "rows" } }
}
