{
  "id": "news",
  "version": "1.4.1",
  "name": "News",
  "description": "The top story large, the next few below, and every headline in a crawl along the bottom. Bind items to an RSS data source.",
  "fields": {
    "title": { "type": "text", "label": "Title", "default": "Latest news", "maxLength": 32 },
    "source": { "type": "text", "label": "Source credit", "default": "", "maxLength": 40 },
    "items": {
      "type": "list",
      "label": "Headlines",
      "maxItems": 30,
      "default": [],
      "item": {
        "title": { "type": "text", "label": "Headline", "maxLength": 200 },
        "published": { "type": "text", "label": "Published (ISO time)", "default": "" },
        "source": { "type": "text", "label": "Source", "default": "" }
      }
    },
    "language": { "type": "text", "label": "Feed language (BCP 47, e.g. fr-FR)", "default": "", "maxLength": 35 },
    "accent": { "type": "color", "label": "Accent colour", "default": "$brand.accent" },
    "crawlSpeed": { "type": "number", "label": "Crawl speed (screen widths per minute)", "default": 6, "min": 2, "max": 20 }
  },
  "duration": { "defaultMs": 15000, "minMs": 6000, "maxMs": 300000 },
  "orientations": ["landscape", "portrait"],
  "uses": [],
  "background": "#0b0d12",
  "live": { "source": "rss", "fields": { "items": "items", "language": "language" } }
}
