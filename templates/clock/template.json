{
  "id": "clock",
  "version": "1.1.0",
  "name": "Clock",
  "description": "Large live clock and date with a greeting. Good as a welcome screen or a break between ads.",
  "fields": {
    "greeting": { "type": "text", "label": "Greeting (empty for good morning/afternoon/evening)", "default": "", "maxLength": 40 },
    "message": { "type": "text", "label": "Message", "default": "", "maxLength": 80 },
    "accent": { "type": "color", "label": "Accent colour", "default": "#7cc4ff" },
    "hour24": { "type": "boolean", "label": "24-hour time", "default": false },
    "seconds": { "type": "boolean", "label": "Show seconds", "default": false }
  },
  "duration": { "defaultMs": 10000, "minMs": 4000, "maxMs": 3600000 },
  "orientations": ["landscape", "portrait"],
  "uses": [],
  "background": "#05070d"
}
