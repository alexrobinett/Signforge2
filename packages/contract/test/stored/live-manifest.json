            "label": "Sunrise, Unix seconds (0: none)",
            "default": 0
          },
          "sunset": {
            "type": "number",
            "label": "Sunset, Unix seconds (0: none)",
            "default": 0
          },
          "wind": {
            "type": "number",
            "label": "Wind speed",
            "default": 5
          },
          "humidity": {
            "type": "number",
            "label": "Humidity %",
            "default": 50
          },
          "unit": {
            "type": "select",
            "label": "Temperature unit",
            "options": ["°F", "°C"],
            "default": "°F"
          },
          "windUnit": {
            "type": "select",
            "label": "Wind unit",
            "options": ["mph", "km/h"],
            "default": "mph"
          }
        },
        "duration": {
          "defaultMs": 8000,
          "minMs": 4000,
          "maxMs": 60000
        },
