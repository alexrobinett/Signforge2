{
  "id": "news-bench",
  "version": "1.0.0",
  "name": "News bench",
  "description": "Pi bench for feed images (#196), never published: the top story's photo large, the next nine stories as thumbnails beside their headlines.",
  "fields": {
    "items": {
      "type": "list",
      "label": "Stories",
