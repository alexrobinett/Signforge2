        "description": "Current conditions with today's high and low. Bind the numeric fields to a weather data source. Bind sunrise and sunset too, and the sun and moon cross the sky with the screen's clock.",
        "duration": {
          "defaultMs": 8000,
          "maxMs": 60000,
          "minMs": 4000
        },
        "fields": {
          "city": {
            "default": "Atlanta",
            "label": "City",
            "maxLength": 24,
            "type": "text"
          },
          "code": {
            "default": 1,
            "label": "WMO weather code",
            "type": "number"
          },
          "high": {
            "default": 78,
            "label": "Today's high",
            "type": "number"
          },
          "humidity": {
            "default": 50,
            "label": "Humidity %",
            "type": "number"
          },
          "isDay": {
            "default": 1,
            "label": "Daytime (1) or night (0)",
            "type": "number"
          },
          "low": {
            "default": 61,
            "label": "Today's low",
            "type": "number"
          },
          "sunrise": {
            "default": 0,
            "label": "Sunrise, Unix seconds (0: none)",
            "type": "number"
          },
          "sunset": {
            "default": 0,
            "label": "Sunset, Unix seconds (0: none)",
            "type": "number"
          },
          "temp": {
            "default": 72,
            "label": "Temperature",
            "type": "number"
          },
          "unit": {
            "default": "°F",
            "label": "Temperature unit",
            "options": [
              "°F",
              "°C"
            ],
            "type": "select"
          },
          "wind": {
            "default": 5,
            "label": "Wind speed",
            "type": "number"
          },
          "windUnit": {
            "default": "mph",
            "label": "Wind unit",
            "options": [
              "mph",
              "km/h"
            ],
            "type": "select"
          }
        },
        "id": "weather",
        "live": {
          "fields": {
            "code": "current.weather_code",
            "high": "daily.temperature_2m_max.0",
            "humidity": "current.relative_humidity_2m",
            "isDay": "current.is_day",
            "low": "daily.temperature_2m_min.0",
            "sunrise": "daily.sunrise.0",
            "sunset": "daily.sunset.0",
            "temp": "current.temperature_2m",
            "wind": "current.wind_speed_10m"
          },
          "place": "city",
          "source": "open-meteo",
          "units": {
            "temperature": "unit",
            "wind": "windUnit"
          }
        },
        "name": "Weather Now",
        "orientations": [
          "landscape",
          "portrait"
        ],
        "protocol": 2,
        "uses": [
          "canvas"
        ],
        "version": "1.5.0"
      }
    }
  }
}
