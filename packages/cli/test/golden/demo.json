    "base/announcement@1.0.2": {
      "manifest": {
        "id": "announcement",
        "version": "1.0.2",
        "name": "Announcement",
        "description": "Company news: a headline and body, a photo, up to three facts and a QR code, in four looks.",
        "fields": {
          "look": {
            "type": "select",
            "label": "Look",
            "options": [
              "pop",
              "poster",
              "night",
              "corporate"
            ],
            "default": "pop"
          },
          "eyebrow": {
            "type": "text",
            "label": "Eyebrow",
            "default": "Company news",
            "maxLength": 24
          },
          "headline": {
            "type": "text",
            "label": "Headline",
            "default": "Pier 9 opens on Monday",
            "maxLength": 80
          },
          "body": {
            "type": "text",
            "label": "Body",
            "default": "Come for coffee, a tour and the first look at the roof terrace.",
            "maxLength": 280
          },
          "meta": {
            "type": "text",
            "label": "Posted by",
            "default": "From the People Team · 20 November",
            "maxLength": 48
          },
          "facts": {
            "type": "list",
            "label": "Facts",
            "maxItems": 3,
            "item": {
              "label": {
                "type": "text",
                "label": "Label",
                "maxLength": 16
              },
              "value": {
                "type": "text",
                "label": "Value",
                "maxLength": 32
              }
            },
            "default": []
          },
          "photo": {
            "type": "image",
            "label": "Photo"
          },
          "qrUrl": {
            "type": "url",
            "label": "QR code link",
            "default": "",
            "maxLength": 100
          },
          "qrLabel": {
            "type": "text",
            "label": "QR code label",
            "default": "Scan for the floor plan",
            "maxLength": 40
          },
          "showPhoto": {
            "type": "boolean",
            "label": "Show the photo",
            "default": true
          },
          "showQr": {
            "type": "boolean",
            "label": "Show the QR code",
            "default": true
          },
          "showEyebrow": {
            "type": "boolean",
            "label": "Show the eyebrow",
            "default": true
          },
          "showBody": {
            "type": "boolean",
            "label": "Show the body",
            "default": true
          },
          "showMeta": {
            "type": "boolean",
            "label": "Show who posted it",
            "default": true
          },
          "showFacts": {
            "type": "boolean",
            "label": "Show the facts",
            "default": true
          },
          "showLogo": {
            "type": "boolean",
            "label": "Show the logo",
            "default": true
          }
        },
        "duration": {
          "defaultMs": 10000,
          "minMs": 5000,
          "maxMs": 60000
        },
        "orientations": [
          "landscape",
          "portrait"
        ],
        "uses": [],
        "background": "#000000",
        "protocol": 2
      },
      "html": "def951d378b0e66e6f9b6ab149118b78f346e4a069acbbb7702930d76c6d4f3a"
    },
    "base/countdown@1.0.2": {
      "manifest": {
        "id": "countdown",
        "version": "1.0.2",
        "name": "Countdown",
        "description": "The days to go to a date and time, or the days since one (a safety record), in four looks.",
        "fields": {
          "look": {
            "type": "select",
            "label": "Look",
            "options": [
              "pop",
              "poster",
              "night",
              "corporate"
            ],
            "default": "pop"
          },
          "mode": {
            "type": "select",
            "label": "Count",
            "options": [
              "down",
              "up"
            ],
            "default": "down"
          },
          "target": {
            "type": "datetime",
            "label": "Counts down to, or up from"
          },
          "title": {
            "type": "text",
            "label": "What it counts to",
            "default": "The winter party",
            "maxLength": 60
          },
          "doneText": {
            "type": "text",
            "label": "Once it is here",
            "default": "It's here!",
            "maxLength": 40
          },
          "units": {
            "type": "select",
            "label": "Units",
            "options": [
              "days",
              "days and hours",
              "days, hours and minutes"
            ],
            "default": "days"
          },
          "recordDays": {
            "type": "number",
            "label": "Record in days, counting up (0 for none)",
            "default": 0,
            "min": 0,
            "max": 99999,
            "step": 1
          },
          "progressDays": {
            "type": "number",
            "label": "Show the progress over the last days, counting down",
            "default": 14,
            "min": 1,
            "max": 999,
            "step": 1
          },
          "facts": {
            "type": "list",
            "label": "Facts",
            "maxItems": 3,
            "item": {
              "label": {
                "type": "text",
                "label": "Label",
                "maxLength": 16
              },
              "value": {
                "type": "text",
                "label": "Value",
                "maxLength": 32
              }
            },
            "default": [
              {
                "label": "Where",
                "value": "Pier 9 roof terrace"
              }
            ]
          },
          "showProgress": {
            "type": "boolean",
            "label": "Show the progress",
            "default": true
          },
          "showRecord": {
            "type": "boolean",
            "label": "Show the record",
            "default": true
          },
          "showFacts": {
            "type": "boolean",
            "label": "Show the facts",
            "default": true
          },
          "showDetail": {
            "type": "boolean",
            "label": "Show the date line",
            "default": true
          }
        },
        "duration": {
          "defaultMs": 10000,
          "minMs": 5000,
          "maxMs": 60000
        },
        "orientations": [
          "landscape",
          "portrait"
        ],
        "uses": [],
        "background": "#000000",
        "protocol": 2
      },
      "html": "8297823b1e5aab66e91d9115215263a1493fae8cf8aa4f9fbff18c925dd3e59c"
