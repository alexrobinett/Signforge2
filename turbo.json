{
  "$schema": "https://turbo.build/schema.json",
  // A change to any of these reruns every task and, on a pull request, marks every package affected
  // (docs/ci.md). Tests read fonts/, which belongs to no package; --affected goes by the package
  // graph, so a file outside every package counts only when it is listed here.
  "globalDependencies": ["tsconfig.base.json", "biome.jsonc", "pnpm-workspace.yaml", ".github/workflows/ci.yml", "fonts/**"],
  "boundaries": {
    "tags": {
      "contract": {
        "dependencies": {
          "allow": []
        }
      }
    }
  },
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "dependsOn": ["^typecheck"],
      "cache": false
    }
  }
}
