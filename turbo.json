{
  "$schema": "https://turbo.build/schema.json",
  "boundaries": {
    "tags": {
      "contract": {
        "dependencies": {
          "allow": []
        }
      }
    }
  },
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "dependsOn": ["^typecheck"],
      "cache": false
    }
  }
}
