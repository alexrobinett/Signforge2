{
  "name": "@signforge/spike-tanstack-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:page": "esbuild src/page/main.tsx --bundle --minify --format=esm --outfile=public/page.js",
    "dev": "pnpm build:page && wrangler d1 migrations apply DB --local && wrangler dev --port 8788",
    "size": "node scripts/size.mjs",
    "typecheck": "wrangler types --strict-vars=false >/dev/null && tsc -p . && tsc -p tsconfig.page.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@signforge/api": "workspace:*",
    "@signforge/db": "workspace:*",
    "@signforge/feeds": "workspace:*",
    "@signforge/tools": "workspace:*",
    "@tanstack/ai": "1.8.0",
    "@tanstack/ai-anthropic": "1.2.1",
    "@tanstack/ai-client": "1.2.1",
    "@tanstack/ai-openai": "1.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
