[Unit]
Description=SignForge spike kiosk (cage + Chromium)
After=systemd-user-sessions.service network-online.target signforge-spike-web.service
Wants=signforge-spike-web.service
Conflicts=getty@tty1.service

[Service]
User=alex
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=-/home/alex/spike/kiosk.env
ExecStart=/usr/bin/cage -s -- /home/alex/spike/kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
