// Dead code: `pnpm knip` (CI runs it). Each entry below is something knip cannot see for itself.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // A throwaway platform spike; its Vitest config reads a migrations folder that is not there.
  "ignoreWorkspaces": ["spike/m3-platform"],
  // A system binary the CLI runs for video probes, not a package.
  "ignoreBinaries": ["ffprobe"],
  "workspaces": {
    // Hand-run scripts (`tsx scripts/<name>.ts`).
    ".": { "entry": ["scripts/*.ts"] },
    // The Worker entry (wrangler.jsonc names `main` per environment, which knip's plugin misses: its
    // exports include the Durable Object classes). auth.config.ts and the `auth` package are the
    // Better Auth CLI (`pnpm exec auth generate --config auth.config.ts`).
    // The templates and their SDK are built by vitest.config.ts for the tests, not imported; declared
    // so that Turbo reruns the tests when one changes (docs/ci.md).
    "apps/api": { "entry": ["src/index.ts", "auth.config.ts"], "ignoreDependencies": ["auth", "@signforge/template-.*"] },
    // shadcn/ui primitives are kept whole as generated, so an unused part (DialogFooter) stays.
    // The e2e run starts the API from apps/api, serves the player build as the test screen and the spot
    // editor's stage, and seeds the templates with the CLI; declaring them makes Turbo rerun the e2e when
    // one changes, and build the player before the CMS.
    "apps/cms": {
      "ignoreIssues": { "src/components/ui/**": ["exports"] },
      "ignoreDependencies": ["@signforge/player", "@signforge/template-.*"]
    },
    // The fixture template is bundled by the browser tests' global setup; sw.js is served as is.
    // templates.test.ts plays every template from templates/: declared as for apps/api.
    "packages/player": { "entry": ["browser/fixtures/template.ts", "public/sw.js"], "ignoreDependencies": ["@signforge/template-(?!sdk).*"] },
    // The hostile fixture is built by the runner's tests, which check every template in templates/:
    // declared as for apps/api. src/runner/main.ts is the container's entry, bundled by build.ts.
    "apps/template-check": {
      "entry": ["test/fixtures/hostile/main.ts", "src/runner/main.ts"],
      "ignoreDependencies": ["@signforge/template-.*"]
    },
    // templates.test.ts builds every template from templates/: declared as for apps/api.
    "packages/cli": { "ignoreDependencies": ["@signforge/template-.*"] },
    // Bundled into a Worker by the upload e2e test.
    "packages/tools": { "entry": ["test/harness-worker.ts"] },
    // Read by url() in each template's style.css; the template build inlines it as a data URL.
    "templates/*": { "ignoreDependencies": ["@fontsource-variable/inter"] },
    // The look kit's test template is built by the player's browser tests and the kit's own, not imported.
    "packages/template-looks": { "entry": ["looks-test/main.ts"] }
  }
}
