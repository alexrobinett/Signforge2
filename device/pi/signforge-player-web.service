[Unit]
Description=SignForge player files (local static server; stands in for the CDN until Milestone 3)

[Service]
User=alex
# www is a link to players/<version> (#628), followed on each request: a switch needs no restart. A working directory
# would stay on the old version's. player_web.py answers with no-store, so Chromium keeps no build in its cache.
WorkingDirectory=/home/alex/signforge
ExecStart=/usr/bin/python3 /home/alex/signforge/player_web.py
Restart=always

[Install]
WantedBy=multi-user.target
