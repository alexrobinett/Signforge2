[Unit]
Description=SignForge kiosk (cage + Chromium)
# Not after the network: the player is offline-first and plays its cached manifest without one.
# Nor after systemd-user-sessions, which waits for NetworkManager (network.target) only so that
# pam_nologin lets users in; a service's PAM session runs no auth stack, so pam_nologin never
# applies here. It needs logind (pam_systemd) and seatd (cage). Measured in
# spike/pi-perf/RESULTS.md, "Linux tuning".
After=systemd-logind.service seatd.service signforge-player-web.service signforge-supervisor.service
Wants=signforge-player-web.service signforge-supervisor.service
Conflicts=getty@tty1.service

[Service]
User=alex
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=-/home/alex/signforge/kiosk.env
ExecStart=/usr/bin/cage -s -- /home/alex/signforge/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
