[Unit]
Description=SignForge device supervisor (display power)
# Listens on 127.0.0.1 only, so it needs no network; the kiosk starts after it.
Before=signforge-kiosk.service

[Service]
User=alex
ExecStart=/usr/bin/python3 /home/alex/signforge/supervisor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
