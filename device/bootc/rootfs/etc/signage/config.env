# Read by signforge-kiosk.service. After an edit: systemctl restart signforge-kiosk
#
# KIOSK_URL is the page the kiosk opens. For a SignForge screen it is the CMS's browser test screen:
#   https://<cms-host>/test-screen/?kind=browser&content=/v1/device
# No secrets in this URL: a template frame can read its parent's address.
# The image build appends the KIOSK_URL line at the end of this file.
#
# CHROMIUM_EXTRA_FLAGS are added to Chromium's command line, split on spaces,
# for example --remote-debugging-port=9222 while checking video decode.
CHROMIUM_EXTRA_FLAGS=
