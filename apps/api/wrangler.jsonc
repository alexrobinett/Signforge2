{
  // SignForge API: CMS API (/api), device API (/v1/device), MCP (/mcp, Milestone 4).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "signforge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "dev", "BUILD_VERSION": "dev", "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>" },
  // Cloudflare Email Sending. Dev records mail instead of sending it (src/email); the binding is
  // here so its type is generated. Secrets (AUTH_SECRET, GITHUB_*) are listed in src/env.d.ts.
  "send_email": [{ "name": "EMAIL" }],
  // Local development and tests use these placeholders; real ids are set per environment.
  "d1_databases": [{ "binding": "DB", "database_name": "signforge-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/db/migrations" }],
  // local_dev: the S3 API wrangler dev serves for this bucket, so presigned asset uploads work
  // locally (src/uploads.ts). Local-only credentials; they open nothing on Cloudflare.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "signforge-dev", "local_dev": { "experimental_s3_credentials": { "accessKeyId": "signforge-local", "secretAccessKey": "signforge-local-only" } } }],
  "env": {
    "demo": {
      "vars": { "ENVIRONMENT": "demo", "BUILD_VERSION": "dev", "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>" },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [{ "binding": "DB", "database_name": "signforge-demo", "database_id": "ba1469f4-9efc-4bea-bb76-9c53c0ae6238", "migrations_dir": "../../packages/db/migrations" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "signforge-demo" }]
    },
    "prod": {
      "vars": { "ENVIRONMENT": "prod", "BUILD_VERSION": "dev", "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>" },
      "send_email": [{ "name": "EMAIL" }],
      "d1_databases": [{ "binding": "DB", "database_name": "signforge-prod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../packages/db/migrations" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "signforge-prod" }]
    }
  }
}
