{
  // SignForge API: CMS API (/api), device API (/v1/device), MCP (/mcp, Milestone 4).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // No top-level entry point, name, vars or bindings, on purpose: every environment is explicit,
  // so a bare `wrangler deploy` (or `wrangler dev`) fails with "Missing entry-point" instead of
  // shipping dev settings (the known dev auth secret, sign-in codes in the log) or an empty Worker.
  // Local work opts in with `--env dev`; the package scripts and vitest.config.ts do.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    // Local development and tests (`wrangler dev --env dev`, vitest). Never deployed.
    "dev": {
      "name": "signforge-api",
      "main": "src/index.ts",
      "vars": {
        "ENVIRONMENT": "dev",
        "BUILD_VERSION": "dev",
        "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>",
        "AGENT_CALLS_DATASET": "signforge_agent_calls_dev",
        // The contract's test-only release key (packages/contract/test/player-release), which signs nothing real.
        "PLAYER_RELEASE_PUBLIC_KEY": "MCowBQYDK2VwAyEAE2z9q2IHuZImrWNK3+j95fk1Ed8+M9JHiCvuMpgShSI="
      },
      // Cloudflare Email Sending. Dev records mail instead of sending it (src/email); the binding is
      // here so its type is generated. Secrets (AUTH_SECRET, GITHUB_*) are listed in src/env.d.ts.
      // Pairing (src/device/pairing.ts): per address for the screen's calls, per member and per
      // address for claims. Counted per Cloudflare location, which is enough to stop guessing.
      // Place search (find_places): per member and per address, each a request to Open-Meteo.
      // Table reads (read_table): per member and per address, each a fetch of a URL the member typed.
      // Agent calls (src/agents/grant-object.ts): per agent grant, AGENT_LIMITS' 120 a minute. Writes are counted in the grant's object.
      // Player releases (src/releases): per address, before the secret is checked, so it cannot be guessed at speed.
      // Template checks (src/template-check.ts): per org, which has one check container. Also counted per
      // location, so an org pushing through two gets two allowances; its container's queue (4) is the exact bound.
      "ratelimits": [
        { "name": "PAIR_START_LIMIT", "namespace_id": "801", "simple": { "limit": 10, "period": 60 } },
        { "name": "PAIR_POLL_LIMIT", "namespace_id": "802", "simple": { "limit": 600, "period": 60 } },
        { "name": "PAIR_CLAIM_LIMIT", "namespace_id": "803", "simple": { "limit": 10, "period": 60 } },
        { "name": "TEMPLATE_CHECK_LIMIT", "namespace_id": "804", "simple": { "limit": 10, "period": 60 } },
        { "name": "PLACE_SEARCH_LIMIT", "namespace_id": "805", "simple": { "limit": 30, "period": 60 } },
        { "name": "TABLE_READ_LIMIT", "namespace_id": "806", "simple": { "limit": 30, "period": 60 } },
        { "name": "PAGE_READ_LIMIT", "namespace_id": "808", "simple": { "limit": 30, "period": 60 } },
        { "name": "CHAT_TURN_LIMIT", "namespace_id": "809", "simple": { "limit": 10, "period": 60 } },
        { "name": "AGENT_CALL_LIMIT", "namespace_id": "807", "simple": { "limit": 120, "period": 60 } },
        { "name": "PLAYER_RELEASE_LIMIT", "namespace_id": "800", "simple": { "limit": 10, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }],
      // Agents' calls over /mcp, one data point each (src/agents/calls.ts); read back through the SQL API.
      "analytics_engine_datasets": [{ "binding": "AGENT_CALLS", "dataset": "signforge_agent_calls_dev" }],
      // One Durable Object per screen, holding its nudge socket (src/device/screen-object.ts), one
      // per agent grant, counting its calls against its limits (src/agents/grant-object.ts), and one
      // per org, holding its publish lock (src/publish.ts).
      "durable_objects": {
        "bindings": [
          { "name": "SCREENS", "class_name": "ScreenObject" },
          { "name": "AGENT_GRANTS", "class_name": "AgentGrantObject" },
          { "name": "ORGS", "class_name": "OrgObject" }
        ]
      },
      // The runtime check of uploaded templates (apps/template-check, src/template-check.ts). Locally,
      // run that Worker's `wrangler dev` beside this one; the tests replace it (vitest.config.ts).
      "services": [{ "binding": "TEMPLATE_CHECK", "service": "signforge-template-check" }],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ScreenObject"] },
        { "tag": "v2", "new_sqlite_classes": ["AgentGrantObject"] },
        { "tag": "v3", "new_sqlite_classes": ["OrgObject"] }
      ],
      // A publish tells its screens through this queue, 50 a message (src/publish.ts). The poller queues the
      // stories' photos it has not fetched to the other (src/data/feed-photos.ts): one a batch, so an invocation's
      // memory, CPU and subrequests (up to 12 fetches, at most two Images calls, R2) are one photo's, within the Free plan's.
      "queues": {
        "producers": [{ "binding": "PUBLISH_NOTICES", "queue": "signforge-publish-notices" }, { "binding": "FEED_IMAGES", "queue": "signforge-feed-images" }],
        "consumers": [
          { "queue": "signforge-publish-notices", "max_batch_size": 10, "max_retries": 3 },
          { "queue": "signforge-feed-images", "max_batch_size": 1, "max_retries": 2 }
        ]
      },
      // Decodes and scales the stories' photos off the Worker's CPU (src/data/feed-photos.ts).
      "images": { "binding": "IMAGES" },
      // The data-source poller every minute (feed-photo cleanup takes each hour's :30 invocation, storage cleanup 02:00 UTC's) and the offline alert check every 5;
      // src/index.ts routes on the schedule. Locally: `wrangler dev --env dev --test-scheduled`, then GET /__scheduled?cron=*/5+*+*+*+*.
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
      // A placeholder id: dev only ever runs locally.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "signforge-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // local_dev: the S3 API wrangler dev serves for this bucket, so presigned asset uploads work
      // locally (src/uploads.ts). Local-only credentials; they open nothing on Cloudflare.
      "r2_buckets": [
        {
          "binding": "BLOBS",
          "bucket_name": "signforge-dev",
          "local_dev": { "experimental_s3_credentials": { "accessKeyId": "signforge-local", "secretAccessKey": "signforge-local-only" } }
        },
        // Player release tarballs (#628), apart from org data: only /v1/player-releases writes them (src/releases).
        { "binding": "PLAYER_RELEASES", "bucket_name": "signforge-releases-dev" }
      ]
    },
    "demo": {
      "name": "signforge-api-demo",
      "main": "src/index.ts",
      "vars": {
        // The Ed25519 key (base64 SPKI DER) player releases are signed with (#628): `/v1/player-releases/register` takes only a
        // release that verifies against it. It must be the key in device/pi/player-release.pub, which screens check (test/releases.test.ts).
        "PLAYER_RELEASE_PUBLIC_KEY": "MCowBQYDK2VwAyEAwCkrMWF7x/CTowuvNj/Nf1gY+pzpogvDKvv1JMlgfks=",
        "ENVIRONMENT": "demo",
        "BUILD_VERSION": "dev",
        "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>",
        "AGENT_CALLS_DATASET": "signforge_agent_calls_demo",
        // The demo's real-feed test: every shown story gets its photo. Past what six feeds polling hourly can bring in a
        // day (250 each, at ten a poll); unset elsewhere, which keeps 60 an org and 30 a source (docs/backend-plan.md).
        "FEED_PHOTOS_ORG_DAILY": "1800",
        "FEED_PHOTOS_SOURCE_DAILY": "300",
        // Its share of the account's 10,000 Queues operations a day (Free plan, #339), at three a message: with prod's 500,
        // 7,500 together, leaving 2,500 for publish notices. The six feeds above bring in about 1,500 a day an org.
        "FEED_PHOTOS_QUEUE_DAILY": "2000",
        // Its share of the account's 5,000 Images transformations a month (Free plan, #500): with prod's 1,000, 4,500
        // together. The two must stay under 5,000 together (docs/backend-plan.md).
        "IMAGES_MONTHLY_TRANSFORMS": "3500"
      },
      // Pairing (src/device/pairing.ts): per address for the screen's calls, per member and per
      // address for claims. Counted per Cloudflare location, which is enough to stop guessing.
      // Place search (find_places): per member and per address, each a request to Open-Meteo.
      // Table reads (read_table): per member and per address, each a fetch of a URL the member typed.
      // Agent calls (src/agents/grant-object.ts): per agent grant, AGENT_LIMITS' 120 a minute. Writes are counted in the grant's object.
      // Player releases (src/releases): per address, before the secret is checked, so it cannot be guessed at speed.
      "ratelimits": [
        { "name": "PAIR_START_LIMIT", "namespace_id": "811", "simple": { "limit": 10, "period": 60 } },
        { "name": "PAIR_POLL_LIMIT", "namespace_id": "812", "simple": { "limit": 600, "period": 60 } },
        { "name": "PAIR_CLAIM_LIMIT", "namespace_id": "813", "simple": { "limit": 10, "period": 60 } },
        { "name": "TEMPLATE_CHECK_LIMIT", "namespace_id": "814", "simple": { "limit": 10, "period": 60 } },
        { "name": "PLACE_SEARCH_LIMIT", "namespace_id": "815", "simple": { "limit": 30, "period": 60 } },
        { "name": "TABLE_READ_LIMIT", "namespace_id": "816", "simple": { "limit": 30, "period": 60 } },
        { "name": "PAGE_READ_LIMIT", "namespace_id": "818", "simple": { "limit": 30, "period": 60 } },
        { "name": "CHAT_TURN_LIMIT", "namespace_id": "819", "simple": { "limit": 10, "period": 60 } },
        { "name": "AGENT_CALL_LIMIT", "namespace_id": "817", "simple": { "limit": 120, "period": 60 } },
        { "name": "PLAYER_RELEASE_LIMIT", "namespace_id": "810", "simple": { "limit": 10, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [{ "binding": "AGENT_CALLS", "dataset": "signforge_agent_calls_demo" }],
      "durable_objects": {
        "bindings": [
          { "name": "SCREENS", "class_name": "ScreenObject" },
          { "name": "AGENT_GRANTS", "class_name": "AgentGrantObject" },
          { "name": "ORGS", "class_name": "OrgObject" }
        ]
      },
      "services": [{ "binding": "TEMPLATE_CHECK", "service": "signforge-template-check" }],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ScreenObject"] },
        { "tag": "v2", "new_sqlite_classes": ["AgentGrantObject"] },
        { "tag": "v3", "new_sqlite_classes": ["OrgObject"] }
      ],
      "queues": {
        "producers": [
          { "binding": "PUBLISH_NOTICES", "queue": "signforge-publish-notices-demo" },
          { "binding": "FEED_IMAGES", "queue": "signforge-feed-images-demo" }
        ],
        "consumers": [
          { "queue": "signforge-publish-notices-demo", "max_batch_size": 10, "max_retries": 3 },
          { "queue": "signforge-feed-images-demo", "max_batch_size": 1, "max_retries": 2 }
        ]
      },
      "images": { "binding": "IMAGES" },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "signforge-demo",
          "database_id": "ba1469f4-9efc-4bea-bb76-9c53c0ae6238",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // PLAYER_RELEASES: player release tarballs (#628), apart from org data: only /v1/player-releases writes them (src/releases).
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "signforge-demo" }, { "binding": "PLAYER_RELEASES", "bucket_name": "signforge-releases-demo" }]
    },
    "prod": {
      "name": "signforge-api-prod",
      "main": "src/index.ts",
      "vars": {
        "ENVIRONMENT": "prod",
        "BUILD_VERSION": "dev",
        "EMAIL_FROM": "SignForge <no-reply@signforge.invalid>",
        "AGENT_CALLS_DATASET": "signforge_agent_calls_prod",
        // No release key yet: prod takes no player release until it has one (`/v1/player-releases` answers 404).
        "PLAYER_RELEASE_PUBLIC_KEY": "",
        // Its share of the account's 10,000 Queues operations a day (Free plan, #339): with demo's 2,000, 7,500 operations
        // together, leaving 2,500 for publish notices.
        "FEED_PHOTOS_QUEUE_DAILY": "500",
        // Its share of the account's 5,000 Images transformations a month (Free plan, #500): no users yet; with demo's
        // 3,500, 4,500 together. The two must stay under 5,000 together (docs/backend-plan.md).
        "IMAGES_MONTHLY_TRANSFORMS": "1000"
      },
      // Pairing (src/device/pairing.ts): per address for the screen's calls, per member and per
      // address for claims. Counted per Cloudflare location, which is enough to stop guessing.
      // Place search (find_places): per member and per address, each a request to Open-Meteo.
      // Table reads (read_table): per member and per address, each a fetch of a URL the member typed.
      // Agent calls (src/agents/grant-object.ts): per agent grant, AGENT_LIMITS' 120 a minute. Writes are counted in the grant's object.
      // Player releases (src/releases): per address, before the secret is checked, so it cannot be guessed at speed.
      "ratelimits": [
        { "name": "PAIR_START_LIMIT", "namespace_id": "821", "simple": { "limit": 10, "period": 60 } },
        { "name": "PAIR_POLL_LIMIT", "namespace_id": "822", "simple": { "limit": 600, "period": 60 } },
        { "name": "PAIR_CLAIM_LIMIT", "namespace_id": "823", "simple": { "limit": 10, "period": 60 } },
        { "name": "TEMPLATE_CHECK_LIMIT", "namespace_id": "824", "simple": { "limit": 10, "period": 60 } },
        { "name": "PLACE_SEARCH_LIMIT", "namespace_id": "825", "simple": { "limit": 30, "period": 60 } },
        { "name": "TABLE_READ_LIMIT", "namespace_id": "826", "simple": { "limit": 30, "period": 60 } },
        { "name": "PAGE_READ_LIMIT", "namespace_id": "828", "simple": { "limit": 30, "period": 60 } },
        { "name": "CHAT_TURN_LIMIT", "namespace_id": "829", "simple": { "limit": 10, "period": 60 } },
        { "name": "AGENT_CALL_LIMIT", "namespace_id": "827", "simple": { "limit": 120, "period": 60 } },
        { "name": "PLAYER_RELEASE_LIMIT", "namespace_id": "820", "simple": { "limit": 10, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "analytics_engine_datasets": [{ "binding": "AGENT_CALLS", "dataset": "signforge_agent_calls_prod" }],
      "durable_objects": {
        "bindings": [
          { "name": "SCREENS", "class_name": "ScreenObject" },
          { "name": "AGENT_GRANTS", "class_name": "AgentGrantObject" },
          { "name": "ORGS", "class_name": "OrgObject" }
        ]
      },
      "services": [{ "binding": "TEMPLATE_CHECK", "service": "signforge-template-check" }],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ScreenObject"] },
        { "tag": "v2", "new_sqlite_classes": ["AgentGrantObject"] },
        { "tag": "v3", "new_sqlite_classes": ["OrgObject"] }
      ],
      "queues": {
        "producers": [
          { "binding": "PUBLISH_NOTICES", "queue": "signforge-publish-notices-prod" },
          { "binding": "FEED_IMAGES", "queue": "signforge-feed-images-prod" }
        ],
        "consumers": [
          { "queue": "signforge-publish-notices-prod", "max_batch_size": 10, "max_retries": 3 },
          { "queue": "signforge-feed-images-prod", "max_batch_size": 1, "max_retries": 2 }
        ]
      },
      "images": { "binding": "IMAGES" },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "signforge-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // PLAYER_RELEASES: player release tarballs (#628), apart from org data. Create the bucket before prod's first deploy.
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "signforge-prod" }, { "binding": "PLAYER_RELEASES", "bucket_name": "signforge-releases-prod" }]
    }
  }
}
