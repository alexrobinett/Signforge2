{
  "name": "signforge",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:e2e",
    "lint": "biome lint --error-on-warnings . && turbo run lint",
    "knip": "knip",
    "dupes": "jscpd",
    "format": "biome format --write --changed --no-errors-on-unmatched",
    "format:check": "biome format --changed --no-errors-on-unmatched",
    "build:player": "pnpm --filter @signforge/player build",
    "build:content": "tsx packages/cli/src/sf.ts build examples/demo --out dist/content",
    "seed:templates": "tsx packages/cli/src/sf.ts template seed templates",
    "build": "pnpm build:player && pnpm build:content",
    "deploy:pi": "sh scripts/deploy-pi.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0"
}
